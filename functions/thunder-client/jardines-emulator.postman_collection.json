{
  "info": {
    "name": "Jardines - Firebase Emulator",
    "description": "Import this Postman v2.1 collection into Thunder Client. Run requests in their numbered order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "projectId", "value": "jardines-de-minerva"},
    {"key": "functionsUrl", "value": "http://127.0.0.1:5002/jardines-de-minerva/us-central1"},
    {"key": "authUrl", "value": "http://127.0.0.1:9100/identitytoolkit.googleapis.com/v1"},
    {"key": "apiKey", "value": "fake-api-key"},
    {"key": "adminEmail", "value": "admin@example.test"},
    {"key": "residentEmail", "value": "resident@example.test"},
    {"key": "password", "value": "correct-horse-battery-staple"},
    {"key": "adminToken", "value": "PASTE_ADMIN_ID_TOKEN"},
    {"key": "residentToken", "value": "PASTE_RESIDENT_ID_TOKEN"},
    {"key": "residentUid", "value": "PASTE_RESIDENT_LOCAL_ID"}
  ],
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "01 Sign up administrator",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{authUrl}}/accounts:signUp?key={{apiKey}}",
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\",\n  \"returnSecureToken\": true\n}"}
          }
        },
        {
          "name": "02 Sign up resident",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{authUrl}}/accounts:signUp?key={{apiKey}}",
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{residentEmail}}\",\n  \"password\": \"{{password}}\",\n  \"returnSecureToken\": true\n}"}
          }
        },
        {
          "name": "03 Sign in administrator",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{authUrl}}/accounts:signInWithPassword?key={{apiKey}}",
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\",\n  \"returnSecureToken\": true\n}"}
          }
        },
        {
          "name": "04 Sign in resident",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{authUrl}}/accounts:signInWithPassword?key={{apiKey}}",
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{residentEmail}}\",\n  \"password\": \"{{password}}\",\n  \"returnSecureToken\": true\n}"}
          }
        }
      ]
    },
    {
      "name": "02 Administration",
      "item": [
        {
          "name": "05 Set resident role",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": "{{functionsUrl}}/setUserRole",
            "body": {"mode": "raw", "raw": "{\n  \"data\": {\n    \"uid\": \"{{residentUid}}\",\n    \"role\": \"resident\"\n  }\n}"}
          }
        },
        {
          "name": "06 Set active rate",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": "{{functionsUrl}}/setActiveRate",
            "body": {"mode": "raw", "raw": "{\n  \"data\": {\n    \"id\": \"standard-2026\",\n    \"residentMonthlyAmountCents\": 10000,\n    \"residentLateFeeCents\": 500\n  }\n}"}
          }
        }
      ]
    },
    {
      "name": "03 Operational flow",
      "item": [
        {
          "name": "07 Create resident",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": "{{functionsUrl}}/createPerson",
            "body": {"mode": "raw", "raw": "{\n  \"data\": {\n    \"id\": \"resident-1\",\n    \"type\": \"resident\",\n    \"firstName\": \"Ada\",\n    \"phone\": \"5550101\",\n    \"authUid\": \"{{residentUid}}\"\n  }\n}"}
          }
        },
        {
          "name": "08 Create lot and assign resident",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": "{{functionsUrl}}/createLot",
            "body": {"mode": "raw", "raw": "{\n  \"data\": {\n    \"id\": \"lot-1\",\n    \"number\": \"1\",\n    \"address\": \"Main Street\",\n    \"status\": \"active\",\n    \"currentResidentId\": \"resident-1\"\n  }\n}"}
          }
        },
        {
          "name": "09 Register vehicle",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": "{{functionsUrl}}/registerVehicle",
            "body": {"mode": "raw", "raw": "{\n  \"data\": {\n    \"id\": \"vehicle-1\",\n    \"ownerId\": \"resident-1\",\n    \"ownerType\": \"resident\",\n    \"type\": \"car\",\n    \"plate\": \"P-123ABC\"\n  }\n}"}
          }
        },
        {
          "name": "10 Generate monthly invoices",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{functionsUrl}}/generateMonthlyInvoices",
            "body": {"mode": "raw", "raw": "{}"}
          }
        },
        {
          "name": "11 Register payment",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": "{{functionsUrl}}/registerPayment",
            "body": {"mode": "raw", "raw": "{\n  \"data\": {\n    \"id\": \"payment-1\",\n    \"personId\": \"resident-1\",\n    \"totalAmountCents\": 10000,\n    \"method\": \"cash\",\n    \"applications\": [{\n      \"invoiceId\": \"resident-1_YYYY-MM\",\n      \"amountCents\": 10000\n    }]\n  }\n}"}
          }
        },
        {
          "name": "12 Void payment",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": "{{functionsUrl}}/voidPayment",
            "body": {"mode": "raw", "raw": "{\n  \"data\": {\n    \"paymentId\": \"payment-1\",\n    \"reason\": \"Duplicate receipt\"\n  }\n}"}
          }
        },
        {
          "name": "13 Unassign resident",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": "{{functionsUrl}}/assignResidentToLot",
            "body": {"mode": "raw", "raw": "{\n  \"data\": {\n    \"lotId\": \"lot-1\",\n    \"residentId\": null\n  }\n}"}
          }
        },
        {
          "name": "14 Deactivate person",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": "{{functionsUrl}}/deactivatePerson",
            "body": {"mode": "raw", "raw": "{\n  \"data\": {\n    \"personId\": \"resident-1\",\n    \"reason\": \"Moved away\"\n  }\n}"}
          }
        },
        {
          "name": "15 Deactivate vehicle",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": "{{functionsUrl}}/deactivateVehicle",
            "body": {"mode": "raw", "raw": "{\n  \"data\": {\n    \"vehicleId\": \"vehicle-1\",\n    \"reason\": \"Permit expired\"\n  }\n}"}
          }
        }
      ]
    },
    {
      "name": "04 Authorization and validation",
      "item": [
        {
          "name": "16 Resident cannot set a rate (expect 403)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{residentToken}}"}],
            "url": "{{functionsUrl}}/setActiveRate",
            "body": {"mode": "raw", "raw": "{\n  \"data\": {\n    \"residentMonthlyAmountCents\": 10000,\n    \"residentLateFeeCents\": 500\n  }\n}"}
          }
        },
        {
          "name": "17 Invalid payment amount (expect 400)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": "{{functionsUrl}}/registerPayment",
            "body": {"mode": "raw", "raw": "{\n  \"data\": {\n    \"id\": \"invalid-payment\",\n    \"personId\": \"resident-1\",\n    \"totalAmountCents\": 12.5,\n    \"method\": \"cash\",\n    \"applications\": []\n  }\n}"}
          }
        }
      ]
    }
  ]
}
