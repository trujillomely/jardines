rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaff() {
      return isAuthenticated() &&
        (request.auth.token.role == "admin" ||
         request.auth.token.role == "treasurer");
    }

    function ownsPerson(personId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/people/$(personId)).data.authUid
          == request.auth.uid;
    }

    // All business writes go through Cloud Functions using the Admin SDK.
    // This prevents clients from bypassing validation and payment transactions.
    match /people/{personId} {
      allow get: if isStaff() ||
        (isAuthenticated() && resource.data.authUid == request.auth.uid);
      allow list: if isStaff();
      allow write: if false;
    }

    match /lots/{lotId} {
      allow read: if isStaff() || ownsPerson(resource.data.currentResidentId);
      allow write: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if isStaff() || ownsPerson(resource.data.ownerId);
      allow write: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isStaff() || ownsPerson(resource.data.personId);
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isStaff() || ownsPerson(resource.data.personId);
      allow write: if false;
      match /applications/{applicationId} {
        allow read: if isStaff() ||
          ownsPerson(get(/databases/$(database)/documents/payments/$(paymentId))
            .data.personId);
        allow write: if false;
      }
    }

    match /rates/{rateId} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}
